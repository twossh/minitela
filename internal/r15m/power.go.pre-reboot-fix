package r15m

import (
	"fmt"

	"github.com/twossh/minitela/internal/protocol"
)

func (c *Connection) PowerOff() error {
	if c == nil || c.Port == nil {
		return fmt.Errorf(
			"MiniTela não conectada",
		)
	}

	_, err := c.WriteRegisterVerified(
		RegisterBrightness,
		0,
	)

	if err != nil {
		return fmt.Errorf(
			"desligar MiniTela: %w",
			err,
		)
	}

	return nil
}

func (c *Connection) Reboot() error {
	if c == nil || c.Port == nil {
		return fmt.Errorf(
			"MiniTela não conectada",
		)
	}

	_ = c.Port.ResetInputBuffer()

	request :=
		protocol.BuildRebootRequest()

	if err :=
		c.Port.WriteAll(request); err != nil {
		return fmt.Errorf(
			"enviar reboot: %w",
			err,
		)
	}

	response, err :=
		c.Port.ReadFrame()

	if err != nil {
		return fmt.Errorf(
			"receber resposta de reboot: %w",
			err,
		)
	}

	if err :=
		protocol.ValidateRebootResponse(
			response,
		); err != nil {
		return fmt.Errorf(
			"validar reboot: %w",
			err,
		)
	}

	return nil
}
